+from src.rolling import moving_average, cumulative_sums, normalize
+
+
+def test_moving_average_basic():
+    assert moving_average([1, 2, 3, 4, 5], 2) == [1.5, 2.5, 3.5]
+
+
+def test_moving_average_wide_window():
+    assert moving_average([10, 20, 30, 40], 3) == [20.0]
+
+
+def test_moving_average_rejects_bad_window():
+    try:
+        moving_average([1, 2], 0)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("expected ValueError")
+
+
+def test_cumulative_sums():
+    assert cumulative_sums([1, 2, 3]) == [1, 3, 6]
+
+
+def test_normalize():
+    assert normalize([1, 1, 2]) == [0.25, 0.25, 0.5]
+
+
+def test_normalize_all_zero():
+    assert normalize([0, 0]) == [0.0, 0.0]
