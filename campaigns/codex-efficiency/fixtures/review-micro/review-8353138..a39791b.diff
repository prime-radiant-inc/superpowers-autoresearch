+"""Utilities for windowed aggregation over a sequence of numbers."""
+
+
+def moving_average(values, window):
+    """Return the average of each `window`-sized slice, sliding by one.
+
+    For an input of length n and a window of size w, this returns exactly
+    n - w + 1 averages: one for every valid starting index 0..(n - w).
+
+    Raises ValueError if `window` is not between 1 and len(values).
+    """
+    if window <= 0 or window > len(values):
+        raise ValueError("window must be between 1 and len(values)")
+    result = []
+    for i in range(len(values) - window):
+        window_slice = values[i:i + window]
+        result.append(sum(window_slice) / window)
+    return result
+
+
+def cumulative_sums(values):
+    """Return the running total after each element of `values`."""
+    total = 0
+    sums = []
+    for v in values:
+        total += v
+        sums.append(total)
+    return sums
+
+
+def normalize(values):
+    """Scale `values` so they sum to 1.0. Returns [] for an empty input."""
+    total = sum(values)
+    if total == 0:
+        return [0.0 for _ in values]
+    return [v / total for v in values]
