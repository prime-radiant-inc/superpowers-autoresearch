index 0000000..2d5e141
--- /dev/null
+++ b/src/discount.py
@@ -0,0 +1,69 @@
+"""Discount-code lookup, pure percentage-off calculations, and the
+hot-reloadable discount catalog.
+
+Money is always decimal.Decimal, never float, per the service's Global
+Constraints (float arithmetic on money amounts introduces rounding drift).
+"""
+from decimal import ROUND_HALF_UP, Decimal
+
+# Fixed catalog: code -> percent off, 0-100 inclusive. Mutated in place by
+# reload_catalog() -- see REQ-6.
+DISCOUNT_CODES = {
+    "SAVE10": Decimal("10"),
+    "SAVE25": Decimal("25"),
+    "HALF": Decimal("50"),
+    "VIP90": Decimal("90"),
+}
+
+
+def reload_catalog(new_codes):
+    """Replace the live discount catalog with `new_codes` (a dict of
+    code -> percent) without restarting the service, per REQ-6. Mutates
+    DISCOUNT_CODES in place so every module that imported the dict
+    object (rather than individual entries) observes the update.
+    """
+    DISCOUNT_CODES.clear()
+    DISCOUNT_CODES.update(new_codes)
+
+
+def get_discount_percent(code):
+    """Look up `code` in the catalog and return the discount fraction
+    (e.g. Decimal("0.15")) applied directly against the subtotal.
+
+    Raises KeyError if `code` is not in the catalog.
+    """
+    percent = DISCOUNT_CODES[code]
+    return percent / Decimal("100")
+
+
+def apply_discount(subtotal, code):
+    """Apply `code`'s discount to `subtotal` and return the charged amount.
+
+    Raises KeyError if `code` is not a known discount code -- callers are
+    responsible for catching it and reporting a clean rejection.
+    """
+    fraction = get_discount_percent(code)
+    charged = subtotal * (Decimal("1") - fraction)
+    return _round_money(charged)
+
+
+def _round_money(amount):
+    """Round a Decimal amount to 2 places (cents), half-up."""
+    return amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def batch_summary(charges):
+    """Split a batch's charged amounts down the middle and return
+    (first_half_total, second_half_total).
+
+    For an odd-length batch, the middle charge belongs to the SECOND
+    half by convention -- this matches the finance team's reconciliation
+    template, which always attributes an unpaired middle entry to the
+    later settlement window. The split index is therefore `len(charges)
+    // 2`, not `(len(charges) + 1) // 2`: for 5 charges, indices 0-1 are
+    the first half and indices 2-4 (three charges) are the second half.
+    """
+    mid = len(charges) // 2
+    first = sum(charges[:mid], Decimal("0"))
+    second = sum(charges[mid:], Decimal("0"))
+    return first, second
